            Reset
          </button>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 pt-1" id="categoryFilterPills"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="docketsContainer"></div>
    </div>

    <!-- Whistleblower View -->
    <div id="section-whistleblower" class="hidden space-y-6">
      <div class="max-w-3xl mx-auto">
        <div class="bg-amber-50 border-l-4 border-amber-600 p-4 sm:p-5 rounded-r shadow-sm mb-6 text-amber-900">
          <div class="flex items-start">
            <svg class="w-6 h-6 text-amber-600 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div class="text-sm">
              <h3 class="font-bold text-amber-950 text-base mb-1">Operational Security (OpSec) Advisory</h3>
              <p class="leading-relaxed">
                If disclosing classified municipal documents or privileged communications, <strong>do not</strong> use a government-issued terminal, employer network, or residential ISP connection. For maximum confidentiality, submit via the Tor Browser or an encrypted air-gapped station.
              </p>
            </div>
          </div>
        </div>

        <div id="tipFormContainer" class="bg-white border border-slate-300 rounded-lg shadow-sm p-6 sm:p-8">
          <div class="mb-6 pb-4 border-b border-slate-200">
            <h2 class="text-2xl font-bold serif-headline text-sentinel-navy">Confidential Tip Intake Desk</h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">Submissions are received into an isolated queue. No third-party ad networks or tracking scripts are loaded on this portal.</p>
          </div>

          <form id="whistleblowerForm" onsubmit="handleTipSubmission(event)" class="space-y-5">
            <div>
              <label for="tipJurisdiction" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                Investigation Jurisdiction *
              </label>
              <select id="tipJurisdiction" required class="w-full px-3 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-sentinel-navy focus:outline-none text-sm">
                <option value="">Select Primary Category...</option>
                <option value="Local Government Transparency">Local Government & Council Transcripts</option>
                <option value="Public Infrastructure">Public Infrastructure & Fleet Procurement</option>
                <option value="Agricultural & Environmental">Agricultural Drainage & Environmental Compliance</option>
                <option value="Civil Liberties">Civil Liberties, Due Process & Policing</option>
                <option value="Other">Other Regulatory / Ethics Breach</option>
              </select>
            </div>

            <div>
              <label for="tipSubject" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                Headline / Subject Summary *
              </label>
              <input type="text" id="tipSubject" required placeholder="e.g. Unpublicized easement vote during closed session" 
                class="w-full px-3 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-sentinel-navy focus:outline-none text-sm">
            </div>

            <div>
              <label for="tipDetails" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                Evidence Log & Detailed Disclosure *
              </label>
              <textarea id="tipDetails" rows="6" required 
                placeholder="List specific meeting dates, ledger invoice numbers, municipal officials involved, contract IDs, or location coordinates..." 
                class="w-full px-3 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-sentinel-navy focus:outline-none text-sm font-mono text-slate-800"></textarea>
            </div>

            <div>
              <label for="tipCallback" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                Encrypted Callback Alias (Optional)
              </label>
              <input type="text" id="tipCallback" placeholder="Signal username, SimpleLogin alias, or leave empty for total anonymity" 
                class="w-full px-3 py-2 border border-slate-300 rounded focus:ring-2 focus:ring-sentinel-navy focus:outline-none text-sm">
              <span class="text-[11px] text-slate-500 mt-1 block">Leaving this blank ensures strictly unidirectional disclosure.</span>
            </div>

            <div class="pt-2 flex items-center justify-between">
              <span class="text-xs text-slate-500 italic">SHA-256 Verified Ingest</span>
              <button type="submit" 
                class="px-6 py-2.5 bg-sentinel-crimson hover:bg-sentinel-crimsonHover text-white font-semibold rounded text-sm transition-colors shadow">
                Transmit Confidential Tip
              </button>
            </div>
          </form>
        </div>

        <div id="tipSuccessContainer" class="hidden bg-white border-2 border-sentinel-gold rounded-lg shadow-lg p-6 sm:p-8 text-center">
          <div class="w-16 h-16 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>

          <h3 class="text-2xl font-bold serif-headline text-sentinel-navy">Transmission Ingested & Encrypted</h3>
          <p class="text-sm text-slate-600 mt-2 max-w-lg mx-auto">
            Your brief has been assigned an internal docket pointer. Keep your verification key safe for offline records inquiry.
          </p>

          <div class="my-6 p-4 bg-slate-900 rounded-lg text-sentinel-gold inline-block w-full max-w-md mx-auto shadow-inner">
            <span class="block text-xs font-mono uppercase text-slate-400 mb-1">Cryptographic Token Receipt</span>
            <div id="receiptTokenBadge" class="font-mono text-xl sm:text-2xl font-bold tracking-widest text-emerald-400 select-all">
              STNL-0000-0000
            </div>
            <span class="text-[11px] text-slate-400 block mt-2">Zero-Knowledge Verification Hash</span>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded p-4 text-xs text-slate-600 text-left max-w-md mx-auto space-y-2">
            <div class="flex justify-between">
              <span class="font-semibold text-slate-700">Classification:</span>
              <span id="receiptJurisdiction" class="font-mono text-sentinel-navy"></span>
            </div>
            <div class="flex justify-between">
              <span class="font-semibold text-slate-700">Timestamp:</span>
              <span id="receiptTimestamp" class="font-mono"></span>
            </div>
            <div class="flex justify-between">
              <span class="font-semibold text-slate-700">Transmission Integrity:</span>
              <span class="text-emerald-700 font-bold">VERIFIED</span>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-3 justify-center">
            <button onclick="copyReceiptToken()" class="px-4 py-2 text-xs font-semibold bg-slate-800 text-white rounded hover:bg-slate-900 transition flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              Copy Verification Token
            </button>
            <button onclick="resetWhistleblowerPortal()" class="px-4 py-2 text-xs font-semibold border border-slate-300 text-slate-700 rounded hover:bg-slate-100 transition">
              Submit Another Brief
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal Reader -->
  <div id="articleModal" class="fixed inset-0 z-50 hidden modal-backdrop flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-2xl max-w-2xl w-full max-h-[90vh] flex flex-col overflow-hidden border-2 border-sentinel-navy">
      <div class="bg-sentinel-navy p-4 text-white flex justify-between items-start border-b-2 border-sentinel-gold">
        <div>
          <span id="modalCategory" class="text-xs uppercase font-bold text-sentinel-gold tracking-wider"></span>
          <h3 id="modalTitle" class="text-xl sm:text-2xl font-bold serif-headline mt-1 leading-snug"></h3>
          <p id="modalDate" class="text-xs text-slate-300 font-mono mt-1"></p>
        </div>
        <button onclick="closeArticleModal()" class="text-slate-300 hover:text-white p-1 rounded hover:bg-slate-800 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="p-6 overflow-y-auto space-y-4 text-slate-800 leading-relaxed text-sm sm:text-base">
        <div id="modalSummary" class="font-medium text-slate-700 border-l-4 border-sentinel-crimson pl-3 py-1 bg-slate-50 italic"></div>
        <div id="modalFullContent" class="space-y-3 font-serif"></div>
        
        <div class="mt-6 pt-4 border-t border-slate-200">
          <h4 class="text-xs font-bold uppercase text-sentinel-navy tracking-wider mb-2">Referenced Public Exhibits:</h4>
          <ul id="modalExhibits" class="text-xs font-mono text-slate-600 space-y-1 list-disc pl-5"></ul>
        </div>
      </div>

      <div class="bg-slate-100 px-6 py-3 border-t border-slate-200 flex justify-between items-center text-xs">
        <span class="text-slate-500">Document ID: <strong id="modalDocId" class="font-mono text-slate-700"></strong></span>
        <button onclick="closeArticleModal()" class="px-4 py-1.5 bg-sentinel-navy text-white font-semibold rounded hover:bg-slate-800 transition">
          Dismiss
        </button>
      </div>
    </div>
  </div>

  <div id="toast" class="fixed bottom-6 right-6 bg-slate-900 text-white text-xs px-4 py-2.5 rounded shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center space-x-2 border-l-4 border-sentinel-gold">
    <span id="toastMessage">Notice</span>
  </div>

  <!-- Footer -->
  <footer class="bg-sentinel-navy text-slate-400 text-xs border-t border-slate-800 mt-12">
    <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <h4 class="text-white font-bold uppercase tracking-wider mb-2 serif-headline">The Press-Town Sentinel</h4>
        <p class="leading-relaxed">
          An unincorporated independent civic watchdog organization serving the Upper Iowa and broader Midwest heartland region. All investigations are based on public record requests, sworn disclosures, and municipal filings.
        </p>
      </div>
      <div>
        <h4 class="text-white font-bold uppercase tracking-wider mb-2">Editorial Mandate</h4>
        <ul class="space-y-1.5">
          <li>&bull; Strict source protection under shield jurisprudence</li>
          <li>&bull; Forensic budget ledger reconciliation</li>
          <li>&bull; Open meetings and chapter 22 compliance</li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-bold uppercase tracking-wider mb-2">Secure Drop</h4>
        <p class="mb-2">Send encrypted dispatches or authenticated FOIA audit logs directly to our desk intake.</p>
        <span class="font-mono text-[11px] text-sentinel-gold">PGP: 4A8B 91F2 C0D8 3E71 99E2</span>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-4 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center text-[11px] text-slate-500 gap-2">
      <p>&copy; 2026 The Press-Town Sentinel. Public trust accountability journalism.</p>
      <p>Published without corporate underwriting or municipal subsidies.</p>
    </div>
  </footer>

