        </div>
        <p class="mt-1 text-xs sm:text-sm text-sentinel-gold font-medium italic tracking-wide">
          Liberty, Law, and Public Accountability for the Heartland
        </p>
      </div>

      <nav class="flex items-center flex-wrap gap-2 pt-2 md:pt-0" aria-label="Main Navigation">
        <button onclick="switchTab('dispatches')" id="tab-dispatches" 
          class="nav-tab px-4 py-2 rounded text-sm font-semibold transition-all duration-150 bg-sentinel-gold text-sentinel-navy shadow">
          Dispatches
        </button>
        <button onclick="switchTab('dockets')" id="tab-dockets" 
          class="nav-tab px-4 py-2 rounded text-sm font-semibold transition-all duration-150 text-slate-200 hover:text-white hover:bg-slate-800">
          Dockets (Inquiries)
