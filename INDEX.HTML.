        </span>
        <span class="hidden sm:inline text-slate-400">|</span>
        <span class="hidden sm:inline">Upper Iowa & Heartland Regional Investigative Desk</span>
      </div>
      <div class="flex items-center space-x-4">
        <span id="currentDateStr" class="font-mono text-slate-300"></span>
        <span class="bg-sentinel-crimson text-white text-[10px] font-bold px-2 py-0.5 rounded tracking-wider uppercase">Open Records Desk</span>
