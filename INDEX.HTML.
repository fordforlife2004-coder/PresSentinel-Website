    <section class="bg-white border-l-4 border-sentinel-crimson rounded-r-lg shadow-sm p-4 sm:p-5 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="serif-headline">
        <p class="text-base sm:text-lg italic text-slate-800">
          "Our liberty depends on the freedom of the press, and that cannot be limited without being lost."
        </p>
        <cite class="block text-xs font-semibold uppercase tracking-wider text-sentinel-navy mt-1 not-italic">
          — Thomas Jefferson, 1786
        </cite>
      </div>
      <div class="shrink-0">
        <span class="inline-flex items-center text-xs font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-700 border border-slate-300">
          Independent Civic Watchdog
        </span>
      </div>
    </section>

    <!-- Dispatches View -->
    <div id="section-dispatches" class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-300 gap-2">
        <div>
          <h2 class="text-2xl font-bold serif-headline text-sentinel-navy">Investigative Dispatches</h2>
          <p class="text-sm text-slate-600">Unfiltered public records, fiscal forensic analysis, and governance audits.</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-slate-500 font-mono">Showing: All Verified Reports</span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="dispatchesContainer"></div>
    </div>

    <!-- Dockets View -->
    <div id="section-dockets" class="hidden space-y-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-slate-300">
        <div>
          <h2 class="text-2xl font-bold serif-headline text-sentinel-navy">Inquiry Dockets & Public Records</h2>
          <p class="text-sm text-slate-600">Tracking open state-level records requests, closed executive sessions, and audit filings.</p>
