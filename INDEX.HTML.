    </div>

    <!-- Masthead -->
    <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded bg-sentinel-gold flex items-center justify-center text-sentinel-navy font-bold text-xl shadow">
            §
