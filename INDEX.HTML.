    let currentSelectedCategory = "All";

    function updateDateDisplay() {
      const now = new Date();
      const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
      document.getElementById('currentDateStr').textContent = now.toLocaleDateString('en-US', options).toUpperCase();
    }

    function switchTab(tabId) {
      const sections = ['dispatches', 'dockets', 'whistleblower'];
      sections.forEach(id => {
        const sec = document.getElementById(`section-${id}`);
        const tab = document.getElementById(`tab-${id}`);
        if (id === tabId) {
          sec.classList.remove('hidden');
          tab.className = "nav-tab px-4 py-2 rounded text-sm font-semibold transition-all duration-150 bg-sentinel-gold text-sentinel-navy shadow";
        } else {
          sec.classList.add('hidden');
          tab.className = "nav-tab px-4 py-2 rounded text-sm font-semibold transition-all duration-150 text-slate-200 hover:text-white hover:bg-slate-800";
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderDispatches() {
      const container = document.getElementById('dispatchesContainer');
      container.innerHTML = articlesData.map(article => `
        <article class="bg-white border border-slate-200 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between overflow-hidden">
          <div class="p-5 sm:p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold uppercase tracking-wider bg-sentinel-navy text-white px-2.5 py-0.5 rounded">
                ${article.category}
              </span>
              <span class="text-xs text-slate-500 font-mono">${article.date}</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold serif-headline text-sentinel-navy mb-2 leading-tight hover:text-sentinel-crimson transition-colors cursor-pointer" onclick="openArticleModal('${article.id}')">
              ${article.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
              ${article.summary}
            </p>
          </div>
          <div class="bg-slate-50 px-5 sm:px-6 py-3 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-mono text-slate-500">${article.id}</span>
            <button onclick="openArticleModal('${article.id}')" class="text-xs font-bold text-sentinel-crimson hover:text-sentinel-crimsonHover inline-flex items-center gap-1">
              Read Briefing 
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </article>
      `).join('');
    }

    function openArticleModal(articleId) {
      const article = articlesData.find(a => a.id === articleId);
      if (!article) return;

      document.getElementById('modalCategory').textContent = article.category;
      document.getElementById('modalTitle').textContent = article.title;
      document.getElementById('modalDate').textContent = `Filed: ${article.date} | Bureau Verification Complete`;
      document.getElementById('modalSummary').textContent = `Executive Abstract: ${article.summary}`;
      document.getElementById('modalDocId').textContent = article.id;

      const fullContentDiv = document.getElementById('modalFullContent');
      fullContentDiv.innerHTML = article.fullText.map(para => `<p>${para}</p>`).join('');

      const exhibitsUl = document.getElementById('modalExhibits');
      exhibitsUl.innerHTML = article.exhibits.map(ex => `<li>${ex}</li>`).join('');

      document.getElementById('articleModal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeArticleModal() {
      document.getElementById('articleModal').classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    function renderCategoryPills() {
      const categories = ["All", ...new Set(docketsData.map(d => d.category))];
      const pillsContainer = document.getElementById('categoryFilterPills');
      pillsContainer.innerHTML = categories.map(cat => `
        <button onclick="setDocketCategory('${cat}')" 
          class="category-pill text-xs px-3 py-1.5 rounded-full font-medium transition ${currentSelectedCategory === cat ? 'bg-sentinel-navy text-white' : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-100'}">
          ${cat}
        </button>
      `).join('');
    }

    function setDocketCategory(category) {
      currentSelectedCategory = category;
      renderCategoryPills();
      filterDockets();
    }

    function filterDockets() {
      const query = document.getElementById('docketSearch').value.toLowerCase().trim();
      const container = document.getElementById('docketsContainer');

      const filtered = docketsData.filter(docket => {
        const matchesCategory = (currentSelectedCategory === "All" || docket.category === currentSelectedCategory);
        const matchesSearch = docket.title.toLowerCase().includes(query) ||
                              docket.description.toLowerCase().includes(query) ||
                              docket.category.toLowerCase().includes(query) ||
                              docket.status.toLowerCase().includes(query);
        return matchesCategory && matchesSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-12 text-center bg-white border border-dashed border-slate-300 rounded-lg">
            <p class="text-slate-500 text-sm">No active dockets matching the specified query.</p>
            <button onclick="clearDocketSearch()" class="mt-2 text-xs text-sentinel-crimson font-bold underline">Clear filters</button>
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map(docket => `
        <div class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm hover:border-slate-300 transition flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-mono uppercase bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">
                ${docket.id}
              </span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded ${
                docket.status.includes('Active') ? 'bg-amber-100 text-amber-900 border border-amber-300' :
                docket.status.includes('Court') ? 'bg-red-100 text-red-900 border border-red-300' :
                'bg-emerald-100 text-emerald-900 border border-emerald-300'
              }">
                ${docket.status}
              </span>
            </div>
            <h4 class="text-lg font-bold text-sentinel-navy serif-headline mb-1">${docket.title}</h4>
            <div class="text-xs font-medium text-sentinel-gold mb-3">${docket.category}</div>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">${docket.description}</p>
          </div>
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-medium text-slate-700">${docket.cases} Active FOIA / Record Leads</span>
            <span class="text-sentinel-crimson font-semibold hover:underline cursor-pointer" onclick="switchTab('whistleblower')">Submit Evidence &rarr;</span>
          </div>
        </div>
      `).join('');
    }

    function clearDocketSearch() {
      document.getElementById('docketSearch').value = '';
      currentSelectedCategory = "All";
      renderCategoryPills();
      filterDockets();
    }

    function handleTipSubmission(event) {
      event.preventDefault();
      
      const jurisdiction = document.getElementById('tipJurisdiction').value;
      const subject = document.getElementById('tipSubject').value.trim();
      const details = document.getElementById('tipDetails').value.trim();

      if (!jurisdiction || !subject || !details) {
        showToast("Please provide all mandatory disclosures.");
        return;
      }

      const array = new Uint8Array(6);
      window.crypto.getRandomValues(array);
      const hexString = Array.from(array, byte => byte.toString(16).padStart(2, '0')).join('').toUpperCase();
      const formattedToken = `STNL-${hexString.slice(0, 4)}-${hexString.slice(4, 8)}-${hexString.slice(8, 12)}`;

      document.getElementById('receiptTokenBadge').textContent = formattedToken;
      document.getElementById('receiptJurisdiction').textContent = jurisdiction;
      document.getElementById('receiptTimestamp').textContent = new Date().toUTCString();

      document.getElementById('tipFormContainer').classList.add('hidden');
      document.getElementById('tipSuccessContainer').classList.remove('hidden');

      showToast("Whistleblower transmission securely ingested.");
    }

    function copyReceiptToken() {
      const token = document.getElementById('receiptTokenBadge').textContent;
      const textArea = document.createElement("textarea");
      textArea.value = token;
      document.body.appendChild(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
        showToast("Token copied to clipboard for offline safekeeping.");
      } catch (err) {
        showToast("Manual copy required: " + token);
      }
      document.body.removeChild(textArea);
    }

    function resetWhistleblowerPortal() {
      document.getElementById('whistleblowerForm').reset();
      document.getElementById('tipSuccessContainer').classList.add('hidden');
      document.getElementById('tipFormContainer').classList.remove('hidden');
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMessage');
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3500);
    }

    window.addEventListener('click', function(e) {
      const modal = document.getElementById('articleModal');
      if (e.target === modal) {
        closeArticleModal();
      }
    });

    window.onload = function() {
      updateDateDisplay();
      renderDispatches();
      renderCategoryPills();
      filterDockets();
    };
  </script>
</body>
</html>
